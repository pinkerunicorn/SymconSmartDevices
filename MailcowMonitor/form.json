{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "URL",
            "caption": "Mailcow URL (z.B. https://mail.ubyte.pink)"
        },
        {
            "type": "PasswordTextBox",
            "name": "APIKey",
            "caption": "API Key (Read-Only)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update Intervall (Sekunden)",
            "minimum": 60
        },
        {
            "type": "CheckBox",
            "name": "MonitorContainers",
            "caption": "Container-Status überwachen"
        },
        {
            "type": "CheckBox",
            "name": "MonitorStorage",
            "caption": "vMail Festplattenplatz überwachen"
        },
        {
            "type": "CheckBox",
            "name": "MonitorMailQueue",
            "caption": "Mail-Warteschlange (Queue) überwachen"
        },
        {
            "type": "Label",
            "caption": "Alarme (Gerätestatus Offline):"
        },
        {
            "type": "NumberSpinner",
            "name": "AlarmStorageThreshold",
            "caption": "Alarm, wenn Festplatte voll (%)",
            "minimum": 1,
            "maximum": 100
        },
        {
            "type": "NumberSpinner",
            "name": "AlarmMailQueueThreshold",
            "caption": "Alarm, wenn Warteschlange > X",
            "minimum": 1
        },
        {
            "type": "CheckBox",
            "name": "AlarmOnUpdate",
            "caption": "Alarm bei neuem Mailcow-Update auslösen"
        },
        {
            "type": "CheckBox",
            "name": "AlarmOnQuarantine",
            "caption": "Alarm auslösen, wenn Mails in Quarantäne sind (> 0)"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Manuelles Update",
            "onClick": "MAILCOW_Update($id);"
        }
    ]
}
