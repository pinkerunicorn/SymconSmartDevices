{
    "elements": [
        {
            "type": "Label",
            "caption": "ImperialDishwasherAI — KI-gestützte Spülmaschinen-Überwachung\n\nDer API-Key und das Modell werden zentral über die SmartGeminiIO Instanz konfiguriert.\nBitte zuerst eine SmartGeminiIO Instanz erstellen und dort den API-Key und das gewünschte Modell eintragen."
        },
        {
            "type": "SelectVariable",
            "name": "PowerVariableID",
            "caption": "Leistungsmessung Spülmaschine (Watt)"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "StartThreshold",
                    "caption": "Einschaltschwelle (Watt)",
                    "digits": 1
                },
                {
                    "type": "NumberSpinner",
                    "name": "AnalysisInterval",
                    "caption": "KI-Analyse Intervall (Minuten)",
                    "minimum": 5,
                    "maximum": 60
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "📊 Jetzt analysieren",
            "onClick": "IDW_AnalyzeData($id);"
        },
        {
            "type": "Button",
            "caption": "📋 Daten sammeln",
            "onClick": "IDW_CollectData($id);"
        }
    ],
    "status": [
        {"code": 102, "icon": "active",   "caption": "Überwachung aktiv."},
        {"code": 104, "icon": "inactive", "caption": "Inaktiv."}
    ]
}
